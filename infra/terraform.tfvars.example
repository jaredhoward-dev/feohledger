# Template for this module's variables. Nothing in here is secret, but a
# filled copy is operator config (bucket names, alert addresses), so it is never
# committed to this public repo: keep the canonical copy in the private
# infra-secrets repo and pass it with -var-file — see README.md.

# Primary AWS region.
aws_region = "us-east-1"

# Project name used for tagging and resource naming.
project = "feohledger"

# Environment (prod, staging, etc.). Becomes part of resource names + tags.
environment = "prod"

# --- S3 bucket names --------------------------------------------------------
# Globally unique. Include a short random suffix so re-creation doesn't
# conflict with the bucket name's 30-day cooldown (AWS keeps deleted bucket
# names reserved briefly to prevent takeover).
invoice_files_bucket_name = "feohledger-invoices-prod-REPLACE"
audit_logs_bucket_name    = "feohledger-audit-logs-prod-REPLACE"
access_logs_bucket_name   = "feohledger-access-logs-prod-REPLACE"
backups_bucket_name       = "feohledger-backups-prod-REPLACE"
# The production secrets ciphertext (secrets_delivery.tf, docs/decisions.md §591).
secrets_bucket_name       = "feohledger-secrets-prod-REPLACE"

# --- Object Lock retention --------------------------------------------------
# Days an object stays locked after it lands. Invoices run in Governance mode
# (legitimate override possible); audit logs run in Compliance mode (no
# override even with root). Defaults match SOC 2 expectations — override if
# your data-retention policy calls for a different number.
# invoice_retention_days = 365
# audit_retention_days   = 2555

# --- Backup retention ---------------------------------------------------------
# The backups bucket (nightly pg dumps from deploy/backup.sh) has no Object
# Lock — this lifecycle window is the whole retention/cost story.
# backup_retention_days = 90

# --- Platform domain ------------------------------------------------------------
# The registered apex the ACM certificate covers and domain.tf manages. Register
# it through Route 53 in this account first — that creates its hosted zone.
# domain_name = "feohledger.com"

# --- Cost alerts ----------------------------------------------------------------
# Every budget notification (50 % / 100 % actual, 100 % forecast) goes to these
# addresses. Required, with no default, so the real address never lands in this
# public repo — and the example.com placeholder is rejected on plan.
budget_alert_emails = ["alerts@example.com"]
# monthly_budget_limit_usd = 75

# --- Email ------------------------------------------------------------------------
# Mailboxes on Migadu, app mail through SES (email.tf, README.md § Email). The
# token is shown at admin.migadu.com → Domains → <domain> after adding the
# domain there; leave it unset until then. The DMARC address is published in
# DNS and must be a mailbox on the platform domain.
# migadu_verification_token = "REPLACE"
# dmarc_report_email        = "ops@feohledger.com"
# dmarc_policy              = "none"   # raise to "quarantine" once reports align

# --- Workload stack ----------------------------------------------------------
# Infrastructure alarms (VM health, database CPU/memory/storage). Required, no
# default — the repo is public. Each address confirms an SNS subscription once.
alert_emails = ["alerts@example.com"]
# app_instance_type        = "t4g.medium"     # Graviton (arm64) only
# db_instance_class        = "db.t4g.micro"
# db_backup_retention_days = 7                # point-in-time-restore window
# db_multi_az              = false            # true when a customer needs an uptime commitment
# db_master_password_version = 1              # bump with each password rotation

# --- Uptime checks + paging (uptime.tf, README.md § Uptime checks and paging) --
# One tenant host to check from outside, alongside the apex and the API. Use a
# tenant you control (a test tenant). Unset skips the tenant check.
# uptime_tenant_slug = "REPLACE"
# The phone the pager topic texts, in E.164 form. Personal data: set it only in
# the private copy. Verify it in the SNS SMS sandbox and get the toll-free
# number registered first, or texts silently fail. Unset means no SMS.
# alert_phone_number = "+1REPLACE"

# --- Backup erasure (backup_erasure.tf, README.md § Backup erasure) -----------
# The OIDC subject prefix the repo presents, read from GitHub — never typed from
# the slug (this repo uses immutable subject claims, so it carries numeric ids):
#   gh api repos/<owner>/feohledger/actions/oidc/customization/sub --jq .sub_claim_prefix
github_oidc_sub_prefix = "repo:REPLACE@0000000/feohledger@0000000"
# The heartbeat + overdue alarms. Leave false until BACKUP_ERASURE_ENABLED is set
# and the workflow's check job has run green once (README.md § Backup erasure step 8).
# backup_erasure_alarms_enabled = true

# --- Secrets delivery (secrets_delivery.tf, README.md § Secrets delivery) ------
# The PRIVATE infra-secrets repo's subject prefix — its CI uploads the
# ciphertext. Read it the same way (it is on immutable subject claims too):
#   gh api repos/<owner>/infra-secrets/actions/oidc/customization/sub --jq .sub_claim_prefix
infra_secrets_oidc_sub_prefix = "repo:REPLACE@0000000/infra-secrets@0000000"
# The same repo as <owner>/<name>: the upload role also pins GitHub's
# job_workflow_ref claim to <this>/.github/workflows/feohledger-upload.yml@refs/heads/main.
infra_secrets_repository = "REPLACE/infra-secrets"
# Who may administer the secrets bucket (delete versions, change versioning,
# the lifecycle or its policy). Default: the Identity Center AdministratorAccess
# role this stack is applied with. Set only if you apply as another principal.
# terraform_admin_principal_arn_patterns = ["arn:aws:iam::<account>:role/<apply-role>"]

# --- Secrets ------------------------------------------------------------------
# Never in a tfvars. The one secret, the RDS master password, is an ephemeral
# variable passed as TF_VAR_db_master_password from
# infra-secrets/feohledger/terraform.sops.yaml on the plan/apply command line —
# README.md § Workload stack.
